<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>familybot.delivery</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_ACCOUNT/.openclaw/workspace/scripts/cron_runner.sh</string>
    <string>delivery</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/YOUR_ACCOUNT/.openclaw/workspace/logs/delivery.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_ACCOUNT/.openclaw/workspace/logs/delivery.log</string>
</dict>
</plist>
