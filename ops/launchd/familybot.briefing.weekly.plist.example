<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>familybot.briefing.weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__FAMILYBOT_WORKSPACE__/scripts/cron_runner.sh</string>
    <string>briefing-weekly</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>FAMILYBOT_WORKSPACE</key>
    <string>__FAMILYBOT_WORKSPACE__</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__FAMILYBOT_WORKSPACE__/logs/briefing.log</string>
  <key>StandardErrorPath</key><string>__FAMILYBOT_WORKSPACE__/logs/briefing.log</string>
</dict></plist>
